# Copy to .env and fill values before running live Groq checks.
GROQ_API_KEY=

# Optional: override default OpenAI-compatible Groq endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: local token warning threshold used by budget helper.
DAILY_TOKEN_BUDGET=200000

# Federal search (at least one of these for GovInfo)
GOVINFO_API_KEY=
# or
DATA_GOV_API_KEY=your_api_data_gov_key

# State bills (recommended)
OPEN_STATES_API_KEY=

# HuggingFace API key
HF_TOKEN=

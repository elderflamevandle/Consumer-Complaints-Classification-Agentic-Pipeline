# ── FinComplaint AI — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values before running.

# ── Groq LLM API ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Token Budget ──────────────────────────────────────────────────────────────
DAILY_TOKEN_BUDGET=200000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=fincomplaint_ai

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Federal / State API Keys (pipeline lookup tools) ─────────────────────────
GOVINFO_API_KEY=
DATA_GOV_API_KEY=
OPEN_STATES_API_KEY=

# ── HuggingFace (optional — embedding models) ────────────────────────────────
HF_TOKEN=

# ── For the web application backend, see web_application/backend/.env.example
# ── for the full list of keys (JWT, CORS, rate limiting, etc.)

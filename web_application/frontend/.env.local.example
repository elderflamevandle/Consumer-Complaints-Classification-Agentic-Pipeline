# ── Frontend environment variables ────────────────────────────────────────────
# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit real values.
# In Docker, these are set via docker-compose.yml environment: block.

# Base URL of the FastAPI backend.
# Local dev (running backend outside Docker): http://localhost:8000
# Docker Compose: http://backend:8000  (set automatically by docker-compose)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional overrides ────────────────────────────────────────────────────────

# Set to 'true' to enable verbose Axios request/response logging in the browser
# console.  Never enable in production.
# NEXT_PUBLIC_DEBUG_API=false

# WebSocket base URL — defaults to deriving from NEXT_PUBLIC_API_URL by
# replacing http(s):// with ws(s)://.  Override only if your setup routes WS
# through a different host/port.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=false
SECRET_KEY=change-me-to-a-random-hex-string-32-bytes

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=fincomplaint_ai
CFPB_COLLECTION=consumer_complaints_classification

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# ── JWT — RS256 (recommended for production) ─────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the PEM content below, replacing newlines with \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=HS256           # Change to RS256 when keys are set

# ── JWT — HS256 fallback (dev only) ──────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-hex-string-for-dev

# ── JWT expiry ────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/15minute
RATE_LIMIT_REFRESH=10/15minute
RATE_LIMIT_DEFAULT=100/15minute
RATE_LIMIT_PIPELINE=20/minute

# ── Account Lockout ───────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ── Groq (for live pipeline — optional) ──────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_MOCK_DELAY_SECONDS=0.4     # Set to 0 in tests; higher for demo effect
DAILY_TOKEN_BUDGET=200000
